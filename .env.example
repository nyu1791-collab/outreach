# ===== Gemini（情報収集・執筆・読み取り・翻訳の全部に使う） =====
# キーは https://aistudio.google.com/apikey で発行。3リポジトリ共通なら Windows に一度だけ:
#   setx GEMINI_API_KEY "キー"   （この .env を空のままにすると Windows の値が使われる）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 用途ごとに変える場合だけ（空なら上の共通モデル）: research / write / translate / ocr / extract / fast
GEMINI_MODEL_WRITE=
GEMINI_MODEL_RESEARCH=
# 安全フィルタで止まりやすい内容（写メ日記・成人向け翻訳）なら relaxed
GEMINI_SAFETY=
# 特定の用途だけ OpenRouter にする場合（例: 翻訳）
LLM_PROVIDER_TRANSLATE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TRANSLATE=
# 任意: Firecrawl クラウド（ローカル起動なら下の FIRECRAWL_API_URL）
FIRECRAWL_API_KEY=
# 任意: 入れるとCSVの代わりにスプレッドシートを使う（サービスアカウントのメールをシートに共有しておく）
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# 任意: Gmail下書き保存（drafts コマンド）
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Firecrawl ローカル（./scripts/firecrawl.ps1 up 後）。クラウドを使うなら FIRECRAWL_API_KEY
FIRECRAWL_API_URL=
# browser-use
BROWSER_USE_MODEL=
ANONYMIZED_TELEMETRY=false
BROWSER_USE_SETUP_LOGGING=true
# 任意: 既存の Chrome を使う場合のパス
CHROME_PATH=
