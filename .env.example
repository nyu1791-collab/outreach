GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 任意: Firecrawl クラウド（ローカル起動なら下の FIRECRAWL_API_URL）
FIRECRAWL_API_KEY=
# 任意: 入れるとCSVの代わりにスプレッドシートを使う（サービスアカウントのメールをシートに共有しておく）
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# 任意: Gmail下書き保存（drafts コマンド）
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Firecrawl ローカル（./scripts/firecrawl.ps1 up 後）。クラウドを使うなら FIRECRAWL_API_KEY
FIRECRAWL_API_URL=
# browser-use
BROWSER_USE_MODEL=
ANONYMIZED_TELEMETRY=false
BROWSER_USE_SETUP_LOGGING=true
# 任意: 既存の Chrome を使う場合のパス
CHROME_PATH=
